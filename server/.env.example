# Copy this file to .env and fill in your values.
# Never commit .env to Git.

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pennywise?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_string
NODE_ENV=development

# ── Optional: Windows / VPN DNS workaround ───────────────────────────────────
# Node's c-ares DNS resolver may inherit a loopback stub (127.0.0.1) from a
# VPN client or WSL2 that cannot resolve SRV records.  If the server fails
# with "querySrv ECONNREFUSED" on startup, set this to a reliable DNS server
# IP address.  Must be a plain IP — hostnames are rejected.
#
# WARNING: dns.setServers() changes DNS resolution GLOBALLY for the Node.js
# process.  Leave this unset in CI and production environments.
#
# Example (Google Public DNS):
# DNS_FALLBACK_SERVER=8.8.8.8
